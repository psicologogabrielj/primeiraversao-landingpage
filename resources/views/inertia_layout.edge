<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {{-- Marca que há JS antes da primeira pintura: só então o CSS esconde as
         seções que o AnimatedSection revela no scroll (ver .reveal no app.css). --}}
    <script>document.documentElement.classList.add('js')</script>

    {{-- Só o que vale para todas as páginas mora aqui. Título, descrição,
         canonical, robots, Open Graph e JSON-LD são de cada página, via <Head>
         do Inertia (@inertiaHead abaixo) — assim a 404 não herda o canonical
         e o "index" da home. --}}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-title" content="Psicólogo Gabriel" />

    <link type="text/plain" rel="author" href="/humans.txt" />

    @viteReactRefresh()
    @vite(['inertia/app/app.tsx', 'resources/css/app.css'])
    @inertiaHead()

    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>
</html>
