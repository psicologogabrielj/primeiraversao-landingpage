<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {{-- Marca que há JS antes da primeira pintura: só então o CSS esconde as
         seções que o AnimatedSection revela no scroll (ver .reveal no app.css). --}}
    <script>document.documentElement.classList.add('js')</script>

    {{-- Só o que vale para todas as páginas mora aqui. Título, descrição,
         canonical, robots, Open Graph e JSON-LD são de cada página, via <Head>
         do Inertia (@inertiaHead abaixo) — assim a 404 não herda o canonical
         e o "index" da home. --}}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-title" content="Psicólogo Gabriel" />

    <link type="text/plain" rel="author" href="/humans.txt" />

    {{-- gtag.js do GA4 e do Google Ads, só na página que passa gtagIds (a
         landing). No HTML do SSR, e não via React, para a visita contar mesmo
         que a hidratação falhe.
         O gtag.js pesa ~150 KB e trava a página por ~100 ms, então só baixa
         na primeira interação ou 4 s depois do load. Até lá os comandos ficam
         na fila do dataLayer — nada se perde, nem a conversão de um clique
         rápido.
         LGPD (Consent Mode): sem o "Aceitar" do banner, o Google não grava
         cookie e só recebe sinais anônimos — a visita ainda conta. A chave
         do localStorage é a mesma de inertia/lib/analytics.ts. --}}
    @if(gtagIds?.length)
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        var consentimento = 'denied';
        try {
          if (localStorage.getItem('consentimento-cookies') === 'aceito') consentimento = 'granted';
        } catch (e) {}
        gtag('consent', 'default', {
          ad_storage: consentimento,
          ad_user_data: consentimento,
          ad_personalization: consentimento,
          analytics_storage: consentimento,
        });

        gtag('js', new Date());
        @each(id in gtagIds)
        gtag('config', '{{ id }}');
        @end

        (function () {
          var gatilhos = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
          function carregar() {
            if (carregar.feito) return;
            carregar.feito = true;
            gatilhos.forEach(function (g) { removeEventListener(g, carregar); });
            var script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id={{ gtagIds[0] }}';
            document.head.appendChild(script);
          }
          gatilhos.forEach(function (g) {
            addEventListener(g, carregar, { once: true, passive: true });
          });
          addEventListener('load', function () { setTimeout(carregar, 4000); });
        })();
      </script>
    @end

    @viteReactRefresh()
    @vite(['inertia/app/app.tsx', 'resources/css/app.css'])
    @inertiaHead()

    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>
</html>
