# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_NAME=psicologo-gabriel
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Domínio oficial (canonical/og/JSON-LD). Só ele é indexável; outros hosts
# recebem noindex. Vazio, vale https://gabrieljesuspsicologo.com.br.
SITE_URL=

# Session
SESSION_DRIVER=cookie

# Google Analytics 4: Measurement ID (G-XXXXXXXXXX). Vazio, o GA não é
# inicializado.
GA_MEASUREMENT_ID=

# Google Ads: ID da tag (AW-...) e send_to da conversão de clique no WhatsApp
# (AW-.../rótulo).
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION=

# PostHog: Project API key (phc_...) e host da região. Sem a key, o PostHog
# não é inicializado.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com