{
  "name": "psicologo-gabriel-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#services/*": "./app/services/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#providers/*": "./providers/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.5.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "1.5.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@poppinss/ts-exec": "1.4.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "hot-hook": "1.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "youch": "4.1.1"
  },
  "dependencies": {
    "@adonisjs/core": "7.5.0",
    "@adonisjs/cors": "3.0.0",
    "@adonisjs/inertia": "5.0.1",
    "@adonisjs/session": "8.1.0",
    "@adonisjs/shield": "9.0.0",
    "@adonisjs/static": "2.0.1",
    "@adonisjs/vite": "6.0.2",
    "@inertiajs/react": "3.7.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-slot": "1.2.3",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "edge.js": "6.5.1",
    "lucide-react": "0.545.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-ga4": "2.1.0",
    "react-icons": "5.5.0",
    "reflect-metadata": "0.2.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "zustand": "5.0.8"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
